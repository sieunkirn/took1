# 챗봇 LLM 보조 설정 (서버 전용). 이 파일을 .env 로 복사해 값을 채운다. .env 는 git 에 올리지 않는다.
# 비워 두면 규칙 챗봇만 쓴다. OpenAI 호환 /chat/completions 주소면 어디든 된다.

# 예) OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<사용할 모델 이름>
# LLM_API_KEY=sk-...

# 예) 로컬 Ollama (키 없음)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3.5:27b

LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=15000
